%%% OBJECTIFS %%%
\newtcolorbox{objectifs}[1][]{%
  colback=\colorbg{pedagoBG}, colframe=pedagoCol, fonttitle=\bfseries,
  title=Objectifs pédagogiques,
  #1}

%%% OBJECTIFS %%%
\newtcolorbox{debriefing}[1][]{%
  colback=\colorbg{pedagoBG}, colframe=pedagoCol, fonttitle=\bfseries,
  title=Retour sur l'activité,
  #1}

%%% EPIGRAMME %%%
\newtcolorbox{epigramme}[1][]{%
  colback=\colorbg{quoteBG}, colframe=quoteCol, fonttitle=\bfseries,
  title=Epigramme d'Alan J. Perlis,
  #1}

%%% CITATION %%%
\newtcolorbox{mycitation}[2][]{%
  left skip=1cm, colback=\colorbg{quoteBG}, colframe=quoteCol,
  title=\textcolor{black}{-- #2}, detach title, after upper={\par\tcbtitle},
  #1
}

\tcbset{pellicule/.style = {enhanced,
      overlay = {
          \pic [tcbcolframe, scale = 0.5] at (title.south west) {pellicule = {value = 42}};
          \pic [tcbcolframe, scale = 0.5] at ([yshift = -2.3mm]title.north west) {pellicule = {value = 42}};
          \pic [tcbcolframe, scale = 0.5] at (frame.south west) {pellicule = {value = 42}};
        }}}

\tcbset{stamp/.style = {enhanced,
      overlay = {
          \node [anchor = north east] at (frame.north east) {\includegraphics[height = 1.4cm]{fig/logo_bw.pdf}};
        }}}

\newtcolorbox{card}[2][]{%
  fonttitle = \bfseries\large, halign title = center, valign = center, boxrule = 0mm, toptitle = 6mm, bottomtitle = 6mm, bottom = 5mm, width = 16.8cm,
  title = #2,
  #1
}

\newtcbox{\cardbox}[2][]{fonttitle = \bfseries\large, halign title = center, toptitle = 3mm, bottomtitle = 3mm, coltitle = black, title = #2, tikznode, #1}
